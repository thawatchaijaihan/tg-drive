[Unit]
Description=GAPT-CINEMA AV1 Pipeline Worker (Telegram → Colab → AV1 → Upload)
After=network.target tg-filestream.service
Wants=tg-filestream.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tg-filestream
EnvironmentFile=-/home/ubuntu/tg-filestream/.env
ExecStart=/usr/bin/python3 /home/ubuntu/tg-filestream/pipeline_worker.py
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gapt-pipeline

# Resource limits
MemoryMax=2G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
